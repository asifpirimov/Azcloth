# Core Settings
SECRET_KEY=your-secure-random-key
DEBUG=False
ALLOWED_HOSTS=azcloth.store,api.azcloth.store,www.azcloth.store

# Database (Supabase Transaction Pooler recommended)
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# CORS & CSRF
CORS_ALLOWED_ORIGINS=https://azcloth.store,https://www.azcloth.store
CSRF_TRUSTED_ORIGINS=https://azcloth.store,https://www.azcloth.store

# Security (Set to True in production)
AUTH_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email — Resend API (HTTPS, port 443)
# Sign up at https://resend.com and add/verify your sending domain.
# Create an API key at https://resend.com/api-keys ("Sending access" only).
RESEND_API_KEY=re_your_key_here
DEFAULT_FROM_EMAIL=noreply@azcloth.store

# Legacy SMTP variables — NO LONGER USED.
# Kept here only so old .env files don't cause ImproperlyConfigured errors.
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@example.com
# EMAIL_HOST_PASSWORD=your_secure_password
# EMAIL_USE_TLS=True
